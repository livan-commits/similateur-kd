CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="managed_components/kodediy__kbsp/partitions.csv"
CONFIG_KODEOS_BOOT_ROLE_APP=y
CONFIG_KODEOS_CONSOLE=y

# ESP32-C5 radio coprocessor + NimBLE host on the ESP32-P4.
CONFIG_KODEOS_RADIO=y
CONFIG_BT_ENABLED=y
CONFIG_KODEOS_BLE=y
CONFIG_KODEOS_BLE_CONSOLE=y
CONFIG_KODE_BLE_APP_VALUE_MAX=512

# LVGL fonts used by the 410x502 screen.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
